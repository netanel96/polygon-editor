{
  "name": "polygon-editor-server",
  "private": true,
  "type": "module",
  "version": "1.0.0",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "test": "node --test --import tsx --import ./test/setupEnv.ts \"test/**/*.test.ts\"",
    "test:integration": "node --test --import tsx --import ./test/setupEnv.ts \"test/**/*.integration.ts\"",
    "test:all": "npm run test && npm run test:integration",
    "build": "tsc --noEmit",
    "start": "tsx src/server.ts"
  },
  "dependencies": {
    "cors": "^2.8.5",
    "dotenv": "^16.5.0",
    "express": "^5.1.0",
    "mongoose": "^8.16.0",
    "nats": "^2.29.3",
    "pino": "^10.3.1",
    "zod": "^3.25.67"
  },
  "devDependencies": {
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.3",
    "@types/node": "^24.0.10",
    "tsx": "^4.20.3",
    "typescript": "^5.8.3"
  }
}
